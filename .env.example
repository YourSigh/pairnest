# PairNest v0.1
# Copy this file to .env, then replace every required blank value.
# Do not commit .env.

# MySQL. Use URL-safe alphanumeric or hexadecimal values because each password
# is interpolated into PAIRNEST_DATABASE_URL by compose.yaml.
PAIRNEST_DB_NAME=pairnest
PAIRNEST_DB_USER=pairnest
PAIRNEST_DB_PASSWORD=
PAIRNEST_DB_ROOT_PASSWORD=

# Authentication. Generate independent values, for example:
#   openssl rand -hex 32
PAIRNEST_APP_SHARED_SECRET=
PAIRNEST_AUTH_TOKEN_SECRET=
PAIRNEST_AUTH_MAX_ACTIVATIONS=6

# API exposure. Keep 127.0.0.1 behind a reverse proxy. Use 0.0.0.0 only when
# you intentionally expose the API to a trusted LAN and understand the risk.
PAIRNEST_API_BIND=127.0.0.1
PAIRNEST_API_PORT=4000
PAIRNEST_CORS_ORIGIN=*
PAIRNEST_TRUST_PROXY=false
PAIRNEST_TIMEZONE=UTC

# Optional mobile development convenience. EXPO_PUBLIC values are embedded in
# the app and are never secret. Leave blank for distributable builds so users
# configure their own PairNest instance on first launch.
EXPO_PUBLIC_PAIRNEST_DEFAULT_API_URL=

# Optional OpenAI-compatible chat service. Disabled when values are blank.
PAIRNEST_AI_API_URL=
PAIRNEST_AI_API_KEY=
PAIRNEST_AI_MODEL=
PAIRNEST_AI_CONTEXT_DIR=
PAIRNEST_AI_CONTEXT_MAX_CHARS=120000

# Optional OpenAI-compatible audio transcription service.
PAIRNEST_TRANSCRIPTION_API_URL=
PAIRNEST_TRANSCRIPTION_API_KEY=
PAIRNEST_TRANSCRIPTION_MODEL=whisper-1
PAIRNEST_TRANSCRIPTION_LANGUAGE=zh

# Optional OpenClaw bridge. Disabled when the token is blank.
PAIRNEST_OPENCLAW_BRIDGE_TOKEN=
PAIRNEST_OPENCLAW_MEDIA_TOKEN_SECRET=
PAIRNEST_OPENCLAW_SESSION_KEY=

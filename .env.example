# PairNest 环境变量示例
# 复制为 .env 后再填写；.env 含有密码和密钥，禁止提交到 Git。
# 密码会直接拼入数据库连接字符串，建议只使用字母、数字或十六进制字符。
# 各类密码和密钥应分别生成，不要重复使用；可执行 openssl rand -hex 32 生成。

# MySQL 创建的业务数据库名称。
PAIRNEST_DB_NAME=pairnest

# MySQL 创建的业务数据库用户名，PairNest API 使用此用户读写数据。
PAIRNEST_DB_USER=pairnest

# 上述业务数据库用户的密码；必填，建议使用独立随机值。
PAIRNEST_DB_PASSWORD=

# MySQL root 管理员密码；必填，仅供数据库初始化和维护使用。
PAIRNEST_DB_ROOT_PASSWORD=

# 新设备首次激活 PairNest 时需要输入的共享密钥；必填，服务端只保存其哈希。
PAIRNEST_APP_SHARED_SECRET=

# 用于签发和校验登录令牌的服务端密钥；必填，泄露后应立即更换。
PAIRNEST_AUTH_TOKEN_SECRET=

# 此实例最多允许激活的设备数量，修改后会同步到服务端认证配置。
PAIRNEST_AUTH_MAX_ACTIVATIONS=6

# API 映射到宿主机的监听地址；127.0.0.1 仅允许本机访问，0.0.0.0 会监听所有网卡。
PAIRNEST_API_BIND=127.0.0.1

# API 映射到宿主机的端口，容器内部固定使用 4000。
PAIRNEST_API_PORT=4000

# 允许浏览器跨域访问 API 的来源；多个来源用英文逗号分隔，* 表示允许任意来源。
PAIRNEST_CORS_ORIGIN=*

# 是否信任反向代理传入的客户端地址和协议；仅在正确配置可信反向代理后设为 true。
PAIRNEST_TRUST_PROXY=false

# MySQL 与 API 容器使用的时区，例如 UTC 或 Asia/Shanghai。
PAIRNEST_TIMEZONE=UTC

# App 开发构建首次启动时预填的后端地址；留空则由用户输入，EXPO_PUBLIC 值会写入安装包。
EXPO_PUBLIC_PAIRNEST_DEFAULT_API_URL=

# OpenAI 兼容聊天接口的基础地址或 /chat/completions 完整地址；留空则关闭 AI 对话。
PAIRNEST_AI_API_URL=

# 调用上述 AI 接口使用的 API Key；只保存在服务端，禁止填写到 EXPO_PUBLIC 变量。
PAIRNEST_AI_API_KEY=

# AI 对话使用的模型名称，必须是上述接口实际支持的模型标识。
PAIRNEST_AI_MODEL=

# 可选的 AI 外部上下文目录；服务端会读取其中的文本作为补充上下文，留空则不读取。
PAIRNEST_AI_CONTEXT_DIR=

# AI 外部上下文最多读取的字符数，用于限制请求体大小和模型上下文占用。
PAIRNEST_AI_CONTEXT_MAX_CHARS=120000

# 语音转写接口模式：audio-transcriptions 或 qwen-chat-completions。
PAIRNEST_TRANSCRIPTION_API_MODE=audio-transcriptions

# 语音转写接口地址；与 Key 任一留空都会关闭语音转文字。
PAIRNEST_TRANSCRIPTION_API_URL=

# 调用语音转写接口使用的 API Key；只在服务端使用。
PAIRNEST_TRANSCRIPTION_API_KEY=

# 语音转写接口使用的模型名称，默认 whisper-1。
PAIRNEST_TRANSCRIPTION_MODEL=whisper-1

# 提交给语音转写接口的音频语言代码，zh 表示中文。
PAIRNEST_TRANSCRIPTION_LANGUAGE=zh

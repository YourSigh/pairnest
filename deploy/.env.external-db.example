# Copy this file to .env on the server. Never commit the resulting .env.
PAIRNEST_API_IMAGE=registry.example.com/namespace/pairnest-api:0.1.0
PAIRNEST_DOCKER_NETWORK=existing-database-network
PAIRNEST_DATABASE_URL=mysql://pairnest:replace_with_url_safe_password@mysql-container:3306/pairnest
PAIRNEST_AUTH_TOKEN_SECRET=

PAIRNEST_ALLOW_OPEN_COUPLE_CREATE=true
PAIRNEST_ALLOW_LEGACY_SHARED_SECRET_ACTIVATE=false
PAIRNEST_API_BIND=127.0.0.1
PAIRNEST_API_PORT=4001
PAIRNEST_CORS_ORIGIN=*
PAIRNEST_TRUST_PROXY=true
PAIRNEST_TIMEZONE=UTC

PAIRNEST_AI_API_URL=
PAIRNEST_AI_API_KEY=
PAIRNEST_AI_MODEL=
PAIRNEST_TRANSCRIPTION_API_URL=
PAIRNEST_TRANSCRIPTION_API_KEY=
